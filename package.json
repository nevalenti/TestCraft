{
  "name": "testcraft",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "lint:contract": "REDOCLY_TELEMETRY=off REDOCLY_SUPPRESS_UPDATE_NOTICE=true redocly lint --config apps/Api/openapi/redocly.yaml",
    "format": "oxfmt . '!apps/Api/openapi/v1.json'",
    "format:check": "oxfmt --check . '!apps/Api/openapi/v1.json'"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@redocly/cli": "^2.72.1",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "turbo": "^2.11.10"
  }
}
