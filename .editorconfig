root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 80

[*.{ts,tsx,js,jsx,mjs,cjs}]
indent_size = 2

[*.{json,jsonc}]
indent_size = 2

[*.{yaml,yml}]
indent_size = 2

[*.{css,scss,less}]
indent_size = 2

[*.{html,htm}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{sh,bash}]
indent_size = 2

[Makefile]
indent_style = tab

[*.cs]
dotnet_analyzer_diagnostic.category-Roslynator.severity = suggestion
dotnet_analyzer_diagnostic.category-Blocker Bug.severity = warning
dotnet_analyzer_diagnostic.category-Critical Bug.severity = warning
dotnet_analyzer_diagnostic.category-Major Bug.severity = suggestion
dotnet_analyzer_diagnostic.category-Minor Bug.severity = suggestion
dotnet_analyzer_diagnostic.category-Blocker Vulnerability.severity = warning
dotnet_analyzer_diagnostic.category-Critical Vulnerability.severity = warning
dotnet_analyzer_diagnostic.category-Major Vulnerability.severity = suggestion
dotnet_analyzer_diagnostic.category-Blocker Code Smell.severity = suggestion
dotnet_analyzer_diagnostic.category-Critical Code Smell.severity = suggestion
dotnet_analyzer_diagnostic.category-Major Code Smell.severity = suggestion
dotnet_analyzer_diagnostic.category-Minor Code Smell.severity = suggestion
dotnet_analyzer_diagnostic.category-Info Code Smell.severity = suggestion
dotnet_analyzer_diagnostic.category-Critical Security Hotspot.severity = suggestion
dotnet_analyzer_diagnostic.category-Major Security Hotspot.severity = suggestion
dotnet_analyzer_diagnostic.category-Minor Security Hotspot.severity = suggestion

indent_size = 4
indent_style = space

csharp_new_line_before_open_brace = all
csharp_new_line_between_query_expression_clauses = true

csharp_space_after_cast = false
csharp_space_after_keywords_in_control_flow_statements = true
csharp_space_between_method_call_parameter_list_parentheses = false
csharp_space_between_method_declaration_parameter_list_parentheses = false

dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = true

dotnet_naming_rule.methods_should_be_pascal_case.severity = suggestion
dotnet_naming_rule.properties_should_be_pascal_case.severity = suggestion
dotnet_naming_rule.private_fields_should_be_camel_case.severity = suggestion
