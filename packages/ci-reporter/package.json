{
  "name": "@testcraft/ci-reporter",
  "version": "0.1.0",
  "description": "Reports CI test results (JUnit) into TestCraft from any CI system, e.g. GitLab CI",
  "main": "./src/core/index.ts",
  "types": "./src/core/index.ts",
  "exports": {
    ".": "./src/core/index.ts"
  },
  "bin": {
    "testcraft-ci-reporter": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "esbuild src/cli.ts --bundle --platform=node --target=node20 --outfile=dist/cli.js --minify --banner:js=\"#!/usr/bin/env node\"",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "typescript": "~6.0.3"
  }
}
