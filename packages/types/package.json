{
  "name": "@testcraft/types",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "generate": "openapi-typescript ../../apps/Api/openapi/contract/v1.json --default-non-nullable false -o src/generated/schema.d.ts",
    "pretypecheck": "pnpm run generate",
    "typecheck": "tsc --noEmit",
    "prebuild": "pnpm run generate",
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "oxlint ."
  },
  "devDependencies": {
    "openapi-typescript": "^7.9.1",
    "typescript": "~6.0.3"
  }
}
