# Shared e2e test constants, loaded by .github/workflows/e2e.yml,
# .gitlab/ci/e2e.yml, and jenkins/e2e/Jenkinsfile so the three pipelines
# can't silently disagree on them. E2E_USERNAME/E2E_PASSWORD must match the
# seeded user in the realm generated by scripts/render-dev-realm.sh, and
# KEYCLOAK_ADMIN_CLIENT_SECRET must match that script's dev client secret.
#
# Values that differ by CI provider's network topology (DATABASE_URL,
# KEYCLOAK_AUTHORITY, VITE_KEYCLOAK_URL) are NOT here - they stay declared
# per-pipeline. POSTGRES_USER/PASSWORD/DB are also declared per-pipeline in
# addition to here, because GitHub Actions' `services:` and GitLab's
# `services:` blocks configure the Postgres container from a static config
# section that can't read this file at that point in the pipeline.

CI=true
SEQ_URL=
MSBUILDTERMINALLOGGER=off
POSTGRES_USER=e2e
POSTGRES_PASSWORD=e2e
POSTGRES_DB=testcraft_e2e
E2E_BASE_URL=http://localhost:4173
E2E_USERNAME=e2e@testcraft.pro
E2E_PASSWORD=e2e-test-password
KEYCLOAK_AUDIENCE=testcraft-web
KEYCLOAK_REQUIRE_HTTPS_METADATA=false
KEYCLOAK_ADMIN_CLIENT_ID=testcraft-api
KEYCLOAK_ADMIN_CLIENT_SECRET=testcraft-api-dev-secret
CORS_ALLOWED_ORIGINS=http://localhost:4173
APPLY_MIGRATIONS=true
VITE_API_URL=http://localhost:5000
VITE_KEYCLOAK_REALM=testcraft
VITE_KEYCLOAK_CLIENT_ID=testcraft-web
TESTCRAFT_PROJECT_NAME=TestCraft
TESTCRAFT_SOURCE=e2e
