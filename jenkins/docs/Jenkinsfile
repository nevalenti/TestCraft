def buildCiReporter() {
    sh 'pnpm --filter testcraft-ci-reporter run build'
}

def reporterCli(String args) {
    return "node packages/ci-reporter/dist/cli.js ${args}"
}

def startTestCraftRun(String runName) {
    withCredentials([
        usernamePassword(credentialsId: 'testcraft-service-account', usernameVariable: 'TESTCRAFT_USERNAME', passwordVariable: 'TESTCRAFT_PASSWORD'),
        string(credentialsId: 'testcraft-api-url', variable: 'TESTCRAFT_API_URL'),
        string(credentialsId: 'testcraft-keycloak-authority', variable: 'TESTCRAFT_KEYCLOAK_AUTHORITY'),
    ]) {
        sh reporterCli("""start \
            --project-name TestCraft \
            --run-name \"${runName}\" \
            --source docs \
            --dotenv .testcraft.env""")
    }
    def dotenv = fileExists('.testcraft.env') ? readFile('.testcraft.env') : ''
    sh 'rm -f .testcraft.env'
    def match = (dotenv =~ /TESTCRAFT_RUN_ID=(.*)/)
    return match ? match[0][1].trim() : ''
}

def importTestCraftResults(String runName, String junitXml) {
    withCredentials([
        usernamePassword(credentialsId: 'testcraft-service-account', usernameVariable: 'TESTCRAFT_USERNAME', passwordVariable: 'TESTCRAFT_PASSWORD'),
        string(credentialsId: 'testcraft-api-url', variable: 'TESTCRAFT_API_URL'),
        string(credentialsId: 'testcraft-keycloak-authority', variable: 'TESTCRAFT_KEYCLOAK_AUTHORITY'),
    ]) {
        def runIdArg = env.TESTCRAFT_RUN_ID ? "--run-id ${env.TESTCRAFT_RUN_ID}" : ''
        sh reporterCli("""import \
            --project-name TestCraft \
            --junit-xml \"${junitXml}\" \
            --run-name \"${runName}\" \
            --source docs ${runIdArg}""")
    }
}

pipeline {
    agent { label 'testcraft' }

    options {
        timeout(time: 10, unit: 'MINUTES')
        disableConcurrentBuilds(abortPrevious: true)
    }

    environment {
        IMAGE_NAME = "ghcr.io/${env.GHCR_OWNER ?: 'nevalenti'}/testcraft-docs"
    }

    stages {
        stage('Resolve branch') {
            steps {
                script {
                    env.GIT_LOCAL_BRANCH = sh(script: "git -c safe.directory='*' rev-parse --abbrev-ref HEAD", returnStdout: true).trim()
                    env.RUN_NAME = "#${env.BUILD_NUMBER} docs (${env.GIT_LOCAL_BRANCH})"
                }
            }
        }

        stage('Install dependencies') {
            steps {
                sh 'corepack enable && corepack prepare pnpm@11.3.0 --activate'
                sh 'pnpm install --frozen-lockfile'
            }
        }

        stage('Typecheck') {
            steps {
                sh 'pnpm --filter testcraft-docs run typecheck'
            }
        }

        stage('Build') {
            steps {
                sh 'pnpm turbo build --filter testcraft-docs'
            }
        }

        stage('Start TestCraft run') {
            steps {
                script {
                    try {
                        buildCiReporter()
                        env.TESTCRAFT_RUN_ID = startTestCraftRun(env.RUN_NAME)
                    } catch (err) {
                        echo "WARNING: could not start TestCraft run: ${err}"
                        currentBuild.result = 'UNSTABLE'
                    }
                }
            }
        }

        stage('Report to TestCraft') {
            steps {
                script {
                    try {
                        importTestCraftResults(env.RUN_NAME, 'apps/docs/test-results/*.junit.xml')
                    } catch (err) {
                        echo "WARNING: TestCraft reporting failed: ${err}"
                        currentBuild.result = 'UNSTABLE'
                    }
                }
            }
            post {
                always {
                    archiveArtifacts artifacts: 'apps/docs/dist/**', allowEmptyArchive: true
                }
            }
        }

        stage('Docker build & scan') {
            when { expression { currentBuild.currentResult == 'SUCCESS' } }
            steps {
                sh "docker build -t docs-scan:${env.GIT_COMMIT} -f apps/docs/Dockerfile ."
                sh """
                    docker run --rm -v /var/run/docker.sock:/var/run/docker.sock \
                        aquasec/trivy:latest image \
                        --format sarif --output /tmp/trivy-results.sarif \
                        --severity CRITICAL,HIGH --ignore-unfixed \
                        docs-scan:${env.GIT_COMMIT} || true
                """
                archiveArtifacts artifacts: 'trivy-results.sarif', allowEmptyArchive: true
            }
        }

        stage('Docker push') {
            when {
                allOf {
                    expression { env.GIT_LOCAL_BRANCH == 'main' }
                    expression { currentBuild.currentResult == 'SUCCESS' }
                }
            }
            steps {
                sh "docker tag docs-scan:${env.GIT_COMMIT} ${env.IMAGE_NAME}:${env.GIT_COMMIT}"
                sh "docker tag docs-scan:${env.GIT_COMMIT} ${env.IMAGE_NAME}:latest"
                withCredentials([usernamePassword(credentialsId: 'ghcr-credentials', usernameVariable: 'REGISTRY_USER', passwordVariable: 'REGISTRY_PASSWORD')]) {
                    sh 'echo "$REGISTRY_PASSWORD" | docker login ghcr.io -u "$REGISTRY_USER" --password-stdin'
                }
                sh "docker push ${env.IMAGE_NAME}:${env.GIT_COMMIT}"
                sh "docker push ${env.IMAGE_NAME}:latest"
            }
        }
    }

    post {
        always {
            sh "docker rmi docs-scan:${env.GIT_COMMIT} || true"
        }
    }
}
