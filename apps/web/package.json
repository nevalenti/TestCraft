{
  "name": "testcraft-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "pretypecheck": "pnpm --filter @testcraft/types run generate && pnpm generate:routes",
    "typecheck": "tsc -b",
    "predev": "pnpm --filter @testcraft/types run generate && pnpm generate:sdk",
    "dev": "vite",
    "prebuild": "pnpm --filter @testcraft/types run generate && pnpm generate:routes",
    "build": "tsc -b && vite build",
    "lint": "oxlint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "generate:sdk": "openapi-ts",
    "check:sdk": "node ../../scripts/check-web-sdk.mjs",
    "generate:routes": "tsr generate"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@heroicons/react": "^2.2.0",
    "@hookform/resolvers": "^5.4.0",
    "@monaco-editor/react": "^4.7.0",
    "@sentry/react": "^10.71.0",
    "@t3-oss/env-core": "^0.13.11",
    "@tanstack/react-query": "^5.101.1",
    "@tanstack/react-router": "^1.170.42",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.13",
    "@testcraft/types": "workspace:*",
    "axios": "^1.20.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "immer": "^11.1.8",
    "keycloak-js": "^26.2.4",
    "monaco-editor": "^0.57.0",
    "nanoid": "^5.1.16",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.80.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.9.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.97.3",
    "@sentry/vite-plugin": "^5.4.1",
    "@tailwindcss/postcss": "^4.3.1",
    "@tailwindcss/vite": "^4.3.1",
    "@tanstack/react-query-devtools": "^5.101.1",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/router-cli": "^1.167.41",
    "@tanstack/router-plugin": "^1.168.43",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "daisyui": "^5.5.23",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-tailwindcss": "4.0.3",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.1",
    "testcraft-ci-reporter": "workspace:*",
    "typescript": "~6.0.3",
    "vite": "^8.1.0",
    "vitest": "^4.1.11"
  }
}
