{
  "name": "testcraft-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "pretypecheck": "pnpm --filter @testcraft/types run generate && pnpm generate:routes",
    "typecheck": "tsc -b",
    "predev": "pnpm --filter @testcraft/types run generate && pnpm generate:sdk",
    "dev": "vite",
    "prebuild": "pnpm --filter @testcraft/types run generate && pnpm generate:routes",
    "build": "tsc -b && vite build",
    "lint": "oxlint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "generate:sdk": "openapi-ts",
    "check:sdk": "node ../../scripts/check-web-sdk.mjs",
    "generate:routes": "tsr generate"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@heroicons/react": "^2.2.0",
    "@hookform/resolvers": "^5.9.2",
    "@monaco-editor/react": "^4.7.0",
    "@sentry/react": "^10.78.0",
    "@t3-oss/env-core": "^0.13.11",
    "@tanstack/react-query": "^5.105.1",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.25",
    "@testcraft/types": "workspace:*",
    "axios": "^1.21.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "immer": "^11.2.9",
    "keycloak-js": "^26.2.5",
    "monaco-editor": "^0.57.0",
    "nanoid": "^5.1.16",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.97.3",
    "@sentry/vite-plugin": "^5.4.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query-devtools": "^5.105.1",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/router-cli": "^1.167.46",
    "@tanstack/router-plugin": "^1.168.48",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^4.1.12",
    "@vitest/ui": "^4.1.12",
    "daisyui": "^5.7.50",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-tailwindcss": "4.0.3",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "testcraft-ci-reporter": "workspace:*",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  }
}
