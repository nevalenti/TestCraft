generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String      @db.VarChar(255)
  description String?
  userId      String      @map("user_id") @db.Uuid
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @default(now()) @map("updated_at")
  isDeleted   Boolean     @default(false) @map("is_deleted")
  deletedAt   DateTime?   @map("deleted_at")
  testSuites  TestSuite[]
  testRuns    TestRun[]

  @@index([userId])
  @@map("projects")
}

model TestSuite {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  description String?
  projectId   String     @map("project_id") @db.Uuid
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @default(now()) @map("updated_at")
  isDeleted   Boolean    @default(false) @map("is_deleted")
  deletedAt   DateTime?  @map("deleted_at")
  project     Project    @relation(fields: [projectId], references: [id])
  testCases   TestCase[]

  @@index([projectId])
  @@map("test_suites")
}

model TestCase {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  description String?
  priority    TestCasePriority @default(Medium)
  suiteId     String           @map("suite_id") @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @default(now()) @map("updated_at")
  isDeleted   Boolean          @default(false) @map("is_deleted")
  deletedAt   DateTime?        @map("deleted_at")
  suite       TestSuite        @relation(fields: [suiteId], references: [id])
  steps       TestCaseStep[]
  testResults TestResult[]

  @@index([suiteId])
  @@index([priority])
  @@map("test_cases")
}

model TestCaseStep {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order          Int
  action         String
  expectedResult String    @map("expected_result")
  testCaseId     String    @map("test_case_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @default(now()) @map("updated_at")
  isDeleted      Boolean   @default(false) @map("is_deleted")
  deletedAt      DateTime? @map("deleted_at")
  testCase       TestCase  @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@index([testCaseId])
  @@map("test_case_steps")
}

model TestRun {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  environment  String
  status       TestRunStatus @default(Active)
  executedById String?       @map("executed_by_id") @db.Uuid
  projectId    String        @map("project_id") @db.Uuid
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @default(now()) @map("updated_at")
  isDeleted    Boolean       @default(false) @map("is_deleted")
  deletedAt    DateTime?     @map("deleted_at")
  project      Project       @relation(fields: [projectId], references: [id])
  testResults  TestResult[]

  @@index([projectId])
  @@map("test_runs")
}

model TestResult {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  status       TestResultStatus
  notes        String?
  executedAt   DateTime         @map("executed_at")
  executedById String?          @map("executed_by_id") @db.Uuid
  testRunId    String           @map("test_run_id") @db.Uuid
  testCaseId   String           @map("test_case_id") @db.Uuid
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @default(now()) @map("updated_at")
  isDeleted    Boolean          @default(false) @map("is_deleted")
  deletedAt    DateTime?        @map("deleted_at")
  testRun      TestRun          @relation(fields: [testRunId], references: [id])
  testCase     TestCase         @relation(fields: [testCaseId], references: [id])

  @@index([testRunId])
  @@index([status])
  @@index([executedAt])
  @@map("test_results")
}

enum TestCasePriority {
  Low
  Medium
  High
  Critical
}

enum TestRunStatus {
  Active
  Completed
  Archived
}

enum TestResultStatus {
  Passed
  Failed
  Blocked
  Skipped
}
