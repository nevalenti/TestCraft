{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://+:80"
      },
      "Https": {
        "Url": "https://+:443",
        "Certificate": {
          "Path": "/etc/gateway/tls/tls.crt",
          "KeyPath": "/etc/gateway/tls/tls.key"
        }
      },
      "KeycloakHttps": {
        "Url": "https://+:8443",
        "Certificate": {
          "Path": "/etc/gateway/tls/tls.crt",
          "KeyPath": "/etc/gateway/tls/tls.key"
        }
      }
    },
    "Limits": {
      "MaxRequestHeadersTotalSize": 131072
    }
  },
  "ReverseProxy": {
    "Routes": {
      "acme-challenge": {
        "ClusterId": "acme-challenge",
        "Order": -3,
        "Match": {
          "Path": "/.well-known/acme-challenge/{**catch-all}"
        }
      },
      "keycloak": {
        "ClusterId": "keycloak",
        "Order": -2,
        "Match": {
          "Hosts": ["*:8443"],
          "Path": "/{**catch-all}"
        },
        "Transforms": [
          { "X-Forwarded": "Append" },
          { "RequestHeaderOriginalHost": "true" }
        ]
      },
      "api": {
        "ClusterId": "api",
        "Order": -1,
        "Match": {
          "Path": "/api/{**catch-all}"
        }
      },
      "hubs": {
        "ClusterId": "api",
        "Order": -1,
        "Match": {
          "Path": "/hubs/{**catch-all}"
        }
      },
      "grafana": {
        "ClusterId": "grafana",
        "Order": -1,
        "Match": {
          "Path": "/grafana/{**catch-all}"
        }
      },
      "seq": {
        "ClusterId": "seq",
        "Order": -1,
        "Match": {
          "Path": "/seq/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/seq" },
          { "X-Forwarded": "Append" }
        ]
      },
      "storage": {
        "ClusterId": "storage",
        "Order": -1,
        "Match": {
          "Path": "/storage/{**catch-all}"
        },
        "Transforms": [{ "PathRemovePrefix": "/storage" }]
      },
      "docs": {
        "ClusterId": "docs",
        "Order": -1,
        "Match": {
          "Path": "/docs/{**catch-all}"
        },
        "Transforms": [{ "PathRemovePrefix": "/docs" }]
      },
      "storage-bucket": {
        "ClusterId": "storage",
        "Order": -1,
        "Match": {
          "Path": "/testcraft-attachments/{**catch-all}"
        },
        "Transforms": [{ "RequestHeaderOriginalHost": "true" }]
      },
      "web": {
        "ClusterId": "web",
        "Order": 0,
        "Match": {
          "Path": "/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "acme-challenge": {
        "Destinations": {
          "destination1": {
            "Address": "http://acme-solver-controller.testcraft.svc.cluster.local:80"
          }
        }
      },
      "keycloak": {
        "Destinations": {
          "destination1": { "Address": "http://keycloak:8080" }
        }
      },
      "api": {
        "Destinations": {
          "destination1": { "Address": "http://api:8080" }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:05:00"
        }
      },
      "grafana": {
        "Destinations": {
          "destination1": { "Address": "http://grafana:3000" }
        }
      },
      "seq": {
        "Destinations": {
          "destination1": { "Address": "http://seq:80" }
        }
      },
      "storage": {
        "Destinations": {
          "destination1": { "Address": "http://minio:9000" }
        }
      },
      "docs": {
        "Destinations": {
          "destination1": { "Address": "http://docs:8080" }
        }
      },
      "web": {
        "Destinations": {
          "destination1": { "Address": "http://web:8080" }
        }
      }
    }
  }
}
